# 敏感配置（含 API Key）
config/llm_providers.json

# 界面运行时模型切换的持久化（本机偏好）
config/webui_model.json

# 启动器偏好（关窗行为 / 开机自启，本机偏好）
config/launcher.json

# 浏览器登录态（含会话 Cookie，等同账号凭证）
config/browser_state.json
data/browser_profile/

# 运行时数据
data/coordinates.json
data/knowledge_base.json
data/raw_materials.jsonl
data/collected_stories.jsonl
data/stories/
data/usage_history.jsonl
data/usage_report.png
# 已发布内容管理快照（从知乎创作中心导出的用户数据）
data/published_answers_*.json
# 草稿箱快照（用户草稿数据，不入库）
data/drafts_*.json

# 个人资产（作者蒸馏档案、元学习知识库——只留本地，不入库）
data/authors/
data/meta/

# 运行产物
logs/
output/
screenshots/

# DeepSeek 历史会话清理产物（扫描报告 + 逐条正文备份，含个人会话内容）
data/cleanup/

# 自动化模块运行状态（计划 / 当日排班 / 台账，属于本机运行数据）
data/state/automation/

# Python
__pycache__/
*.pyc

# 测试临时目录（tests/test_user_feedback.py 在工作区根下建，带 pid）
_tmp_fb_test*/

# 草稿记录（含历史 API Key 备注）
config/1.txt

# Playwright MCP 运行日志与页面快照（调试产物）
.playwright-mcp/

# 打包产物（一键启动器 + 安装包）
build/
dist/
release/
AutoQuill.exe

# 个人编辑器配置（含本机路径）
.vscode/

# Claude Code 个人配置（权限白名单等，仅本机）
.claude/settings.local.json
